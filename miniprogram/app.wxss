page {
  background: #f3f7f4;
  color: #19383b;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}
button { font-family: inherit; }
.page { padding: 28rpx 30rpx 54rpx; }
.hero { padding: 34rpx 30rpx; border-radius: 30rpx; color: #fff; background: linear-gradient(145deg,#103c43,#14776c 72%,#25937d); box-shadow: 0 16rpx 42rpx rgba(23,62,56,.10); }
.eyebrow { color: #bce9d9; font-size: 19rpx; font-weight: 800; letter-spacing: 3rpx; }
.hero-title { display: block; margin-top: 14rpx; font-size: 48rpx; line-height: 1.3; font-weight: 900; }
.hero-desc { display: block; margin-top: 10rpx; color: #e2f2ec; font-size: 24rpx; line-height: 1.6; }
.hero-actions { display: flex; align-items: center; justify-content: space-between; margin-top: 26rpx; gap: 14rpx; }
.hero-note { color: #ccece0; font-size: 20rpx; }
.section-head { display: flex; align-items: flex-end; justify-content: space-between; margin: 36rpx 4rpx 18rpx; }
.section-title { display: block; font-size: 34rpx; font-weight: 900; }
.section-desc,.count { color: #6a8181; font-size: 21rpx; }
.section-desc { display: block; margin-top: 6rpx; }
.count { white-space: nowrap; }
.search { box-sizing: border-box; width: 100%; height: 78rpx; margin-bottom: 18rpx; padding: 0 24rpx; border: 1rpx solid #e2ece8; border-radius: 24rpx; background: #fff; font-size: 24rpx; }
.trip-card,.panel,.day-card,.empty { margin-bottom: 18rpx; padding: 26rpx; border: 1rpx solid #e7efeb; border-radius: 28rpx; background: #fff; box-shadow: 0 10rpx 34rpx rgba(23,62,56,.035); }
.trip-card-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 14rpx; }
.trip-name { display: block; font-size: 33rpx; line-height: 1.35; font-weight: 900; }
.meta { margin-top: 8rpx; color: #6a8181; font-size: 21rpx; }
.dest { margin-top: 18rpx; color: #3c6866; font-size: 24rpx; }
.card-bottom { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; margin-top: 22rpx; padding-top: 18rpx; border-top: 1rpx solid #edf2ef; }
.muted { color: #6a8181; font-size: 21rpx; }
.button-row { display: flex; flex-wrap: wrap; gap: 12rpx; }
.btn { display: inline-flex; align-items: center; justify-content: center; margin: 0; padding: 0 24rpx; min-height: 70rpx; border: 0; border-radius: 22rpx; background: #14776c; color: #fff; font-size: 23rpx; font-weight: 800; line-height: 1.3; }
.btn::after { border: 0; }
.btn.primary { background: #fff; color: #103c43; }
.btn.secondary { background: #e5f5ed; color: #14776c; }
.btn.ghost { background: #f1f6f3; color: #19383b; }
.btn.danger { background: #fff0ed; color: #b24c3d; }
.btn.small { min-height: 58rpx; padding: 0 19rpx; border-radius: 18rpx; font-size: 20rpx; }
.icon-btn { min-width: 60rpx; min-height: 58rpx; padding: 0 14rpx; border: 0; border-radius: 16rpx; background: #f1f6f3; color: #54706d; font-size: 21rpx; }
.backup-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 6rpx; }
.help { margin-top: 25rpx; padding: 22rpx; border-radius: 22rpx; background: #eaf3ef; color: #52706d; font-size: 21rpx; line-height: 1.65; }
.empty { text-align: center; color: #6a8181; font-size: 24rpx; }
.nav-row { display: flex; align-items: center; justify-content: space-between; margin: 8rpx 2rpx 18rpx; }
.back { padding: 12rpx 0; color: #14776c; font-size: 24rpx; font-weight: 800; }
.trip-heading { padding: 28rpx; border: 1rpx solid #e2ece8; border-radius: 28rpx; background: #fff; }
.detail-title { font-size: 40rpx; line-height: 1.3; font-weight: 900; }
.chips { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 18rpx; }
.chip { padding: 8rpx 16rpx; border-radius: 99rpx; background: #e5f5ed; color: #39766a; font-size: 19rpx; font-weight: 750; }
.budget { display: flex; justify-content: space-between; gap: 10rpx; margin-top: 18rpx; padding: 18rpx; border-radius: 18rpx; background: #fff5df; color: #795d2b; font-size: 22rpx; }
.budget-value { font-weight: 900; }
.detail-actions { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }
.day-card { padding: 23rpx; }
.day-head { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-bottom: 14rpx; }
.day-title { font-size: 30rpx; font-weight: 900; }
.stop { padding: 20rpx 0 8rpx; border-top: 1rpx solid #edf2ef; }
.stop-top { display: flex; align-items: flex-start; gap: 17rpx; }
.stop-time { width: 100rpx; padding: 9rpx 8rpx; border-radius: 14rpx; background: #fff3df; color: #86652a; text-align: center; font-size: 20rpx; font-weight: 850; }
.stop-main { flex: 1; min-width: 0; }
.stop-title { font-size: 27rpx; font-weight: 850; line-height: 1.4; }
.stop-type { display: inline-block; margin-left: 9rpx; padding: 3rpx 11rpx; border-radius: 99rpx; background: #eff5f2; color: #69817d; font-size: 17rpx; vertical-align: 3rpx; }
.stop-address,.stop-note { display: block; margin-top: 8rpx; color: #51706e; font-size: 21rpx; line-height: 1.55; word-break: break-all; }
.stop-note { color: #6a8181; white-space: pre-wrap; }
.stop-actions { display: flex; justify-content: flex-end; flex-wrap: wrap; gap: 9rpx; margin: 13rpx 0 4rpx; }
.day-empty { padding: 16rpx 4rpx; color: #809390; text-align: center; font-size: 21rpx; }
.overlay { position: fixed; z-index: 10; inset: 0; display: flex; align-items: flex-end; justify-content: center; padding: 20rpx 18rpx env(safe-area-inset-bottom); background: rgba(13,42,45,.8); }
.modal { box-sizing: border-box; width: 100%; max-height: 88vh; overflow-y: auto; padding: 27rpx; border-radius: 30rpx; background: #fff; }
.modal-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; font-size: 32rpx; font-weight: 900; }
.field { margin: 15rpx 0; }
.label { display: block; margin-bottom: 9rpx; color: #52706d; font-size: 21rpx; font-weight: 800; }
.input,.textarea,.picker { box-sizing: border-box; width: 100%; min-height: 76rpx; padding: 18rpx 20rpx; border: 1rpx solid #e2ece8; border-radius: 18rpx; background: #fbfdfb; color: #19383b; font-size: 24rpx; }
.textarea { min-height: 140rpx; }
.modal-actions { display: flex; justify-content: flex-end; gap: 12rpx; margin-top: 22rpx; }
@media (min-width: 600px) { .page { max-width: 750rpx; margin: 0 auto; } }
